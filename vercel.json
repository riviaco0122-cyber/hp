{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/pages/index.html" },
    { "source": "/robots.txt", "destination": "/seo/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/seo/sitemap.xml" },
    { "source": "/llms.txt", "destination": "/seo/llms.txt" },
    { "source": "/media/:file.html", "destination": "/pages/media/:file.html" },
    { "source": "/:file.html", "destination": "/pages/:file.html" }
  ]
}
