{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/pages/index.html"
    },
    {
      "source": "/robots.txt",
      "destination": "/seo/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/seo/sitemap.xml"
    },
    {
      "source": "/llms.txt",
      "destination": "/seo/llms.txt"
    },
    {
      "source": "/media/:file.html",
      "destination": "/pages/media/:file.html"
    },
    {
      "source": "/:file.html",
      "destination": "/pages/:file.html"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/media/category-akiya.html",
      "destination": "/media/category-house.html",
      "permanent": true
    },
    {
      "source": "/media/category-market.html",
      "destination": "/media/category-trend.html",
      "permanent": true
    },
    {
      "source": "/media/category-chiho.html",
      "destination": "/media/category-trend.html",
      "permanent": true
    },
    {
      "source": "/media/category-kaigyo.html",
      "destination": "/media/category-start.html",
      "permanent": true
    },
    {
      "source": "/media/category-keiei.html",
      "destination": "/media/category-operate.html",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/:file.html",
      "destination": "/:file.html",
      "permanent": true
    },
    {
      "source": "/media/akiya-rate-and-inn.html",
      "destination": "/media/why-akiya-utilization-now.html",
      "permanent": true
    },
    {
      "source": "/media/japan-tourism-market-data.html",
      "destination": "/media/long-stay-travel-demand.html",
      "permanent": true
    },
    {
      "source": "/media/akiya-regional-revitalization.html",
      "destination": "/media/why-akiya-utilization-now.html",
      "permanent": true
    },
    {
      "source": "/media/airdna-revenue-simulation.html",
      "destination": "/media/inn-kpi-basics.html",
      "permanent": true
    },
    {
      "source": "/media/inbound-regional-dispersion.html",
      "destination": "/media/long-stay-travel-demand.html",
      "permanent": true
    },
    {
      "source": "/media/tourism-labor-shortage.html",
      "destination": "/media/cleaning-linen-operations.html",
      "permanent": true
    },
    {
      "source": "/media/kankei-jinko-and-inns.html",
      "destination": "/media/why-minpaku-for-akiya.html",
      "permanent": true
    },
    {
      "source": "/media/akiya-local-resource.html",
      "destination": "/media/why-akiya-utilization-now.html",
      "permanent": true
    },
    {
      "source": "/media/inn-local-economy.html",
      "destination": "/media/why-minpaku-for-akiya.html",
      "permanent": true
    },
    {
      "source": "/media/akiya-data-9-million.html",
      "destination": "/media/why-akiya-utilization-now.html",
      "permanent": true
    },
    {
      "source": "/media/kominka-stay-value.html",
      "destination": "/media/kominka-renovation-points.html",
      "permanent": true
    },
    {
      "source": "/media/minpaku-partner-choose.html",
      "destination": "/media/minpaku-management-company.html",
      "permanent": true
    }
  ],
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in seo/daily) exit 1;; seo/*) exit 0;; *) exit 1;; esac"
}
